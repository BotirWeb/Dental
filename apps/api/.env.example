# Bu faylni .env qilib nusxalang va haqiqiy qiymatlarni kiriting.
# .env HECH QACHON repo'ga tushmaydi (qollanma bo'lim 9, qoida 8).

# PostgreSQL ulanish satri
DATABASE_URL=postgres://dental_app:CHANGE_ME@localhost:5432/dental_dev

# Server porti
PORT=3000

# Session cookie sozlamalari
SESSION_COOKIE_NAME=dental_session
# Prod'da "true" bo'lishi shart (faqat HTTPS orqali yuboriladi)
SESSION_COOKIE_SECURE=false

# Sessiya muddati (T3, tahlil D2): idle (harakatsizlik) va absolyut chegara
# BIRGA ishlaydi — qaysi biri oldin yetsa. "Bitta smena sig'adi, ketgan
# xodim ertasiga eski cookie bilan kira olmaydi."
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Login ekranida "Klinika kodi" bo'sh qoldirilsa ishlatiladigan klinika
# (T2, tahlil C4). Bitta klinikali joylashuv uchun qulaylik — ko'p klinikali
# joylashuvda BO'SH qoldiring, xodim har doim o'z klinika kodini kiritsin.
DEFAULT_CLINIC_SLUG=namuna-klinika

# CSRF/Origin tekshiruvi (T3, tahlil D2): vergul bilan ajratilgan ruxsat
# etilgan origin'lar (masalan prod'da https://klinika1.misol-domen.uz).
# BO'SH bo'lsa — faqat so'rov o'zi kelgan origin (same-origin) ruxsat etiladi,
# bu ko'pchilik joylashuv uchun (bo'lim 3.3: bitta origin) yetarli.
ALLOWED_ORIGINS=

# Ilova qaysi muhitda ishlayotgani
NODE_ENV=development
