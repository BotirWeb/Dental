# Bu faylni .env qilib nusxalang va haqiqiy qiymatlarni kiriting.
# .env HECH QACHON repo'ga tushmaydi (qollanma bo'lim 9, qoida 8).

# PostgreSQL ulanish satri
DATABASE_URL=postgres://dental_app:CHANGE_ME@localhost:5432/dental_dev

# Server porti
PORT=3000

# Session cookie sozlamalari
SESSION_COOKIE_NAME=dental_session
SESSION_TTL_HOURS=168
# Prod'da "true" bo'lishi shart (faqat HTTPS orqali yuboriladi)
SESSION_COOKIE_SECURE=false

# Ilova qaysi muhitda ishlayotgani
NODE_ENV=development
